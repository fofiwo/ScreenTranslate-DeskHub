<Window x:Class="OverTranslate.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:OverTranslate.Views.Settings"
        Title="ScreenTranslate" Width="1220" Height="800" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ShowInTaskbar="True"
        Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="QuickToolHotkeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="80"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailEntry" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ProductFocus}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccentSubtle}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailNavigation" TargetType="RadioButton" BasedOn="{StaticResource ProductNav}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="12,0" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailAction" TargetType="Button" BasedOn="{StaticResource RailEntry}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style x:Key="TranslationMode" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ProductFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Surface" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                            <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot" Background="{DynamicResource AppWindowBg}">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <Button x:Name="SidebarToggleBtn" Style="{StaticResource WindowSidebarToggle}" Content="&#xE700;" WindowChrome.IsHitTestVisibleInChrome="True" Click="SidebarToggleBtn_Click"/>
                <TextBlock Text="ScreenTranslate" FontSize="12" Margin="12,0" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">

                <Button x:Name="MinimizeBtn" Style="{StaticResource WindowCaptionButton}" Content="&#xE921;" Click="MinimizeBtn_Click"/>
                <Button x:Name="MaximizeBtn" Style="{StaticResource WindowCaptionButton}" Content="&#xE922;" Click="MaximizeBtn_Click"/>
                <Button x:Name="CloseBtn" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216" MinWidth="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ProductRailBg}" BorderBrush="{DynamicResource AppSubtleBorder}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="RailPanel" Margin="12,8,12,12" ClipToBounds="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,12,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/ScreenTranslate;component/icons/screentranslate-logo.png" Width="30" Height="30" Margin="0,0,8,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ScreenTranslate Logo"/>
                        <TextBlock Text="ScreenTranslate" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="翻译、剪贴板与资料管理" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border Height="1" Background="{DynamicResource AppSubtleBorder}" Margin="12,0,12,8"/>
                    <Button Content="设备与同步" Style="{StaticResource RailAction}" Click="Devices_Click" HorizontalContentAlignment="Left"/>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource RailNavigation}" Height="36" Margin="0,1" GroupName="ShellNav" Checked="Nav_Checked"><TextBlock Text="设置"/></RadioButton>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="AboutNav" Style="{StaticResource RailNavigation}" Height="36" Margin="0,1" GroupName="ShellNav" Checked="Nav_Checked" Content="{DynamicResource S.Shell.About}"/>
                        <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource RailAction}" Height="28" Padding="6,0" VerticalAlignment="Center" Content="安装新版" Visibility="Collapsed" Click="UpdateButton_Click" Foreground="{DynamicResource AppAccent}" AutomationProperties.Name="安装可用的新版本"/>
                    </Grid>
                    <TextBlock x:Name="VersionText" Margin="12,8,0,0" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Text="关闭窗口后继续驻留托盘" Margin="12,4,0,0" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
                <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="工具" Margin="12,0,0,6" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <RadioButton x:Name="TranslationNav" Style="{StaticResource RailNavigation}" GroupName="ShellNav" Checked="TranslationNav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" Style="{StaticResource ProductGlyph}"/><TextBlock Text="屏幕翻译" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ScreenshotNav" Style="{StaticResource RailNavigation}" GroupName="ShellNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource ProductGlyph}"/><TextBlock Text="截图工具" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <Button x:Name="ClipboardHistoryBtn" Style="{StaticResource RailEntry}" Click="ClipboardHistoryBtn_Click" AutomationProperties.Name="剪贴板历史，打开独立窗口" AutomationProperties.AcceleratorKey="{Binding Text, ElementName=ClipboardHotkeyText}">
                            <Button.ToolTip><StackPanel><TextBlock Text="打开剪贴板历史浮窗"/><TextBlock x:Name="ClipboardHotkeyText" Margin="0,4,0,0"/></StackPanel></Button.ToolTip>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77F;" Style="{StaticResource ProductGlyph}"/>
                                <TextBlock Grid.Column="1" Text="剪贴板历史" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="LibraryBtn" Style="{StaticResource RailEntry}" Click="LibraryBtn_Click" AutomationProperties.Name="提示词与模型资料，打开独立窗口" AutomationProperties.AcceleratorKey="{Binding Text, ElementName=LibraryHotkeyText}">
                            <Button.ToolTip><StackPanel><TextBlock Text="打开提示词与模型资料独立窗口"/><TextBlock x:Name="LibraryHotkeyText" Margin="0,4,0,0"/></StackPanel></Button.ToolTip>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource ProductGlyph}"/>
                                <TextBlock Grid.Column="1" Text="提示词与模型资料" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                        <TextBlock x:Name="LibrarySummaryText" Margin="12,0,8,0" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="{DynamicResource S.Shell.QuickTools}" Margin="12,12,0,4" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <Button x:Name="ScreenshotBtn" ToolTipService.ShowOnDisabled="True" Style="{StaticResource RailAction}" Click="ScreenshotBtn_Click" AutomationProperties.Name="截图与标注" AutomationProperties.AcceleratorKey="{Binding Text, ElementName=ScreenshotHotkeyText}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                <TextBlock Text="截图标注" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScreenshotHotkeyText" Grid.Column="1" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="OcrExtractBtn" ToolTipService.ShowOnDisabled="True" Style="{StaticResource RailAction}" Click="OcrExtractBtn_Click" AutomationProperties.Name="提取文字并复制" AutomationProperties.AcceleratorKey="{Binding Text, ElementName=OcrHotkeyText}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                <TextBlock Text="提取文字" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OcrHotkeyText" Grid.Column="1" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="PinImageBtn" Style="{StaticResource RailAction}" Click="PinImageBtn_Click" AutomationProperties.Name="贴图（剪贴板图片）" AutomationProperties.AcceleratorKey="{Binding Text, ElementName=PinImageHotkeyText}" ToolTip="将剪贴板图片贴到桌面">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                                <TextBlock Text="贴图" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PinImageHotkeyText" Grid.Column="1" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18,8,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel x:Name="TranslationHeader" Margin="36,20,36,0">
                    <TextBlock Text="屏幕翻译" Style="{StaticResource PageTitle}"/>
                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                            <RadioButton x:Name="HomeNav" Content="截图翻译" Style="{StaticResource TranslationMode}" GroupName="TranslationMode" Checked="Nav_Checked"/>
                            <RadioButton x:Name="RealtimeNav" Content="{DynamicResource S.Realtime.Title}" Style="{StaticResource TranslationMode}" GroupName="TranslationMode" Checked="Nav_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" x:Name="ContentHost" Background="{DynamicResource AppSurfaceBg}" CornerRadius="16" RenderOptions.ClearTypeHint="Enabled">
                    <Border.RenderTransform><TranslateTransform x:Name="ContentTransform"/></Border.RenderTransform>
                </Border>
            </Grid>
            <settings:ServiceSettingsOverlay Grid.ColumnSpan="2" x:Name="ServiceSettings"/>
            <settings:DiagnosticNoteOverlay Grid.ColumnSpan="2" x:Name="DiagnosticNote"/>
        </Grid>
    </Grid>
</Window>
