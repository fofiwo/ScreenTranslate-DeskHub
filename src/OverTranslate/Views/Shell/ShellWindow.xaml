<Window x:Class="OverTranslate.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:OverTranslate.Views.Settings"
        Title="ScreenTranslate" Width="1220" Height="800" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ShowInTaskbar="True"
        Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="QuickToolHotkeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot" Background="{DynamicResource AppWindowBg}">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <Button x:Name="SidebarToggleBtn" Style="{StaticResource WindowSidebarToggle}" Content="&#xE700;" WindowChrome.IsHitTestVisibleInChrome="True" Click="SidebarToggleBtn_Click"/>
                <TextBlock Text="ScreenTranslate" FontSize="12" Margin="12,0" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">

                <Button x:Name="MinimizeBtn" Style="{StaticResource WindowCaptionButton}" Content="&#xE921;" Click="MinimizeBtn_Click"/>
                <Button x:Name="MaximizeBtn" Style="{StaticResource WindowCaptionButton}" Content="&#xE922;" Click="MaximizeBtn_Click"/>
                <Button x:Name="CloseBtn" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216" MinWidth="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ProductRailBg}" BorderBrush="{DynamicResource AppSubtleBorder}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="RailPanel" Margin="14,8,12,18" ClipToBounds="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,16,0,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/ScreenTranslate;component/icons/screentranslate-logo.png"
                               Width="34" Height="34" Margin="0,0,8,0" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ScreenTranslate Logo"/>
                        <TextBlock Text="ScreenTranslate" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="看懂屏幕，就这么简单" FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,14,4,0">
                    <Button Content="设备与同步" Style="{StaticResource NavActionItem}" Click="Devices_Click"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource NavActionItem}" Content="检查更新" Click="UpdateButton_Click"/>
                    <Button Style="{StaticResource NavActionItem}" Content="{DynamicResource S.Shell.About}" Click="AboutBtn_Click"/>
                    <TextBlock x:Name="VersionText" Margin="14,8,0,0" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Text="关闭主窗口后继续驻留托盘" Margin="14,5,0,0" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid x:Name="NavPanel">
                        <Border x:Name="NavIndicator" Opacity="0" Background="{DynamicResource AppAccent}" Width="3" Height="18" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTransform"/></Border.RenderTransform>
                        </Border>
                        <StackPanel Margin="0">
                            <RadioButton x:Name="HomeNav" Style="{StaticResource ProductNav}" GroupName="ShellNav" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" Style="{StaticResource ProductGlyph}"/><TextBlock Text="截图翻译" VerticalAlignment="Center"/></StackPanel></RadioButton>
                            <RadioButton x:Name="RealtimeNav" Style="{StaticResource ProductNav}" GroupName="ShellNav" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource ProductGlyph}"/><TextBlock Text="{DynamicResource S.Shell.RealtimeTranslate}" VerticalAlignment="Center"/></StackPanel></RadioButton>


                            <RadioButton x:Name="SettingsNav" Style="{StaticResource ProductNav}" GroupName="ShellNav" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource ProductGlyph}"/><TextBlock Text="服务与设置" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource AppBorder}" Margin="16,18,16,14"/>
                    <TextBlock Text="{DynamicResource S.Shell.QuickTools}" Margin="16,0,0,10" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="ScreenshotBtn" ToolTipService.ShowOnDisabled="True" Style="{StaticResource RailQuickTool}" Click="ScreenshotBtn_Click" AutomationProperties.Name="截图与标注">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="截图标注" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="ScreenshotHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/></Viewbox>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PinImageBtn" Grid.Column="1" Style="{StaticResource RailQuickTool}" Click="PinImageBtn_Click" AutomationProperties.Name="贴图（剪贴板图片）" ToolTip="将剪贴板图片贴到桌面">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="贴图" TextAlignment="Center"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="PinImageHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/></Viewbox>
                        </StackPanel>
                    </Button>
                    </Grid>
                    <Button x:Name="CaptureBtn" ToolTipService.ShowOnDisabled="True" Style="{StaticResource RailQuickTool}" Click="CaptureBtn_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="框选屏幕" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock x:Name="CaptureHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OcrExtractBtn" ToolTipService.ShowOnDisabled="True" Style="{StaticResource RailQuickTool}" Click="OcrExtractBtn_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="提取文字并复制" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock x:Name="OcrHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryBtn" Style="{StaticResource RailQuickTool}" Click="LibraryBtn_Click" AutomationProperties.Name="打开提示词与模型资料">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="提示词与模型资料" TextAlignment="Center"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock x:Name="LibraryHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LibrarySummaryText" Margin="8,4,8,0" FontSize="11" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button x:Name="ClipboardHistoryBtn" Style="{StaticResource RailQuickTool}" Click="ClipboardHistoryBtn_Click"
                            AutomationProperties.Name="打开剪贴板历史" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="剪贴板历史" TextAlignment="Center"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock x:Name="ClipboardHotkeyText" Style="{StaticResource QuickToolHotkeyText}"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
            <Border Grid.Column="1" x:Name="ContentHost" Background="{DynamicResource AppSurfaceBg}" CornerRadius="16" Margin="18,8,18,18" RenderOptions.ClearTypeHint="Enabled">
                <Border.RenderTransform><TranslateTransform x:Name="ContentTransform"/></Border.RenderTransform>
            </Border>
            <settings:ServiceSettingsOverlay Grid.ColumnSpan="2" x:Name="ServiceSettings"/>
            <settings:DiagnosticNoteOverlay Grid.ColumnSpan="2" x:Name="DiagnosticNote"/>
        </Grid>
    </Grid>
</Window>
