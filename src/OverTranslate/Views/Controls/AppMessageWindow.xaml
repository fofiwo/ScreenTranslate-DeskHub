<Window x:Class="OverTranslate.Views.Controls.AppMessageWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
 Width="520" MaxHeight="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterScreen" Style="{StaticResource ProductToolWindow}">
 <DockPanel Background="{DynamicResource AppWindowBg}">
  <controls:ToolWindowHeader DockPanel.Dock="Top"/>
  <StackPanel Margin="24">
   <DockPanel><TextBlock x:Name="SeverityText" DockPanel.Dock="Left" FontSize="22" Width="32" Foreground="{DynamicResource AppAccent}"/>
    <TextBlock x:Name="MessageTitle" Style="{StaticResource ProductDialogTitle}"/></DockPanel>
   <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,24">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
   </ScrollViewer>
   <WrapPanel x:Name="Actions" HorizontalAlignment="Right"/>
  </StackPanel>
 </DockPanel>
</Window>
