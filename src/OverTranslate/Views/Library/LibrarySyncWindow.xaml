<Window x:Class="OverTranslate.Views.Library.LibrarySyncWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="局域网同步 · ScreenTranslate" Width="650" Height="720" MinWidth="560" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppWindowBg}"
 Foreground="{DynamicResource AppTextPrimary}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppWindowBg}"><StackPanel x:Name="SyncForm" Margin="24">
  <TextBlock Text="局域网双向同步" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="同一局域网的电脑使用相同配对码。任意一端添加对方地址即可双向同步；所有电脑都填写彼此地址，可在部分电脑离线时继续互通。" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock Text="同步提示词、模型资料及 API Key。新增、修改和删除自动传播，同时修改保留冲突副本；首次连接合并两端已有资料。" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <CheckBox x:Name="EnabledBox" Content="启用局域网同步（软件运行时自动同步）" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,16"/>
  <TextBlock Text="本机局域网 IP" FontWeight="SemiBold"/>
  <TextBlock x:Name="LocalIpText" TextWrapping="Wrap" Margin="0,5,0,12"/>
  <TextBlock Text="本机监听端口"/>
  <TextBox x:Name="PortBox" Style="{DynamicResource ModernTextBox}" Margin="0,5,0,12" AutomationProperties.Name="本机同步端口"/>
  <TextBlock Text="配对码" FontWeight="SemiBold"/>
  <TextBlock Text="在第一台电脑生成，在其他电脑粘贴同一码。持有码的设备可读写同步资料；请仅交给自己的设备。留空保留本机已保存的代码。" TextWrapping="Wrap" Margin="0,5,0,8"/>
  <PasswordBox x:Name="CodeBox" Height="34" Padding="8,0" VerticalContentAlignment="Center" AutomationProperties.Name="局域网同步配对码"/>
  <WrapPanel Margin="0,8,0,12">
   <Button x:Name="GenerateButton" Content="生成新配对码" Style="{DynamicResource ProductSecondaryButton}" Click="Generate_Click" Margin="0,0,8,0"/>
   <Button Content="复制配对码" Style="{DynamicResource ProductSecondaryButton}" Click="CopyCode_Click"/>
  </WrapPanel>
  <TextBlock Text="对方局域网地址（每行一个，IP:端口）" FontWeight="SemiBold"/>
  <TextBox x:Name="PeersBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="90" Style="{DynamicResource ModernTextBox}" Margin="0,5,0,8" AutomationProperties.Name="同步设备地址"/>
  <TextBlock Text="例如 192.168.1.20:48539。首次连接如有防火墙提示，请允许专用网络访问。两台电脑须运行支持同步的版本；无需配置路由器端口转发。" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <WrapPanel>
   <Button x:Name="SaveButton" Content="保存并应用" Style="{DynamicResource ProductButton}" Click="Save_Click" Margin="0,0,8,0"/>
   <Button Content="立即同步" Style="{DynamicResource ProductSecondaryButton}" Click="SyncNow_Click"/>
  </WrapPanel>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
</Window>
