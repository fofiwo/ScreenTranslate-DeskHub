<Window x:Class="OverTranslate.Views.Library.LibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="提示词与模型资料 · ScreenTranslate" Width="1120" Height="760" MinWidth="880" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppWindowBg}"
 Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="13"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Language="zh-CN"
 Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <!-- 仅在资料库内优先使用中文 UI 字体，共享控件也从此处解析 AppFont。 -->
  <FontFamily x:Key="AppFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="LibraryCodeFont">Consolas, Microsoft YaHei UI</FontFamily>
  <Style x:Key="LibraryTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="LineHeight" Value="34"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style x:Key="LibraryDetailTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="LineHeight" Value="30"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="MaxHeight" Value="60"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style x:Key="LibraryListTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="LineHeight" Value="21"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style x:Key="LibraryMeta" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="LineHeight" Value="18"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style x:Key="LibraryListSummary" TargetType="TextBlock" BasedOn="{StaticResource LibraryMeta}">
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0,3,0,0"/>
  </Style>
  <Style x:Key="LibraryBody" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="LineHeight" Value="24"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style x:Key="LibraryDescription" TargetType="TextBlock" BasedOn="{StaticResource LibraryBody}">
   <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="22"/>
   <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style x:Key="LibraryFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LibraryMeta}">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,4"/>
  </Style>
  <Style x:Key="LibraryData" TargetType="TextBlock" BasedOn="{StaticResource LibraryBody}">
   <Setter Property="FontFamily" Value="{StaticResource LibraryCodeFont}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="LineHeight" Value="22"/>
  </Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ProductSecondaryButton}">
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="4,0,0,0"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ProductLink}">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Foreground" Value="{DynamicResource AppError}"/>
  </Style>
  <Style x:Key="LibraryLabel" TargetType="TextBlock" BasedOn="{StaticResource LibraryFieldLabel}">
   <Setter Property="Margin" Value="0,16,0,7"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
  <Style x:Key="MultilineField" TargetType="TextBox" BasedOn="{StaticResource SettingsMultilineTextBox}">
   <Setter Property="FontSize" Value="14"/><Setter Property="TextBlock.LineHeight" Value="24"/>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
   <Setter Property="MinHeight" Value="34"/><Setter Property="FocusVisualStyle" Value="{StaticResource ProductFocus}"/>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EditablePlatform" TargetType="ComboBox">
   <Setter Property="Height" Value="34"/><Setter Property="FontFamily" Value="{DynamicResource AppFont}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource AppInputBg}"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource ProductFocus}"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource AppInputBg}"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource ProductFocus}"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}"/>
  <Style x:Key="LibraryRow" TargetType="ListBoxItem" BasedOn="{StaticResource ProductListItem}">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid Background="Transparent">
     <Border x:Name="RowSurface" Background="Transparent" BorderBrush="{DynamicResource AppSubtleBorder}" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
     <Border x:Name="SelectionMark" Width="3" HorizontalAlignment="Left" Background="Transparent" Margin="0,8"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/><Setter TargetName="SelectionMark" Property="Background" Value="{DynamicResource AppAccent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SelectedDetail" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource AppSurfaceBg}"/>
   <Setter Property="Padding" Value="18,12,0,0"/>
   <Style.Triggers><Trigger Property="DataContext" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="DetailTag"><Border Background="{DynamicResource AppHeaderBg}" Padding="7,2" Margin="0,0,6,4" CornerRadius="3"><TextBlock Text="{Binding}" Style="{StaticResource LibraryMeta}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></Border></DataTemplate>
  <Style x:Key="FilterTag" TargetType="ListBoxItem" BasedOn="{StaticResource ProductListItem}">
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,6"/>
  </Style>

 </Window.Resources>
 <Grid Background="{DynamicResource AppWindowBg}"><Grid Margin="20,16,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="提示词与模型资料" Style="{StaticResource LibraryTitle}" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
    <TextBlock x:Name="ShortcutHint" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AppTextSecondary}"/>
    <Button Content="AI 整理设置" Style="{StaticResource SmallButton}" Click="AiSettings_Click" Margin="0,0,8,0"/>
    <Button Content="快捷键" Style="{StaticResource SmallButton}" Click="Shortcut_Click"/>

   </StackPanel>
  </Grid>

  <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_Changed" BorderThickness="0" Background="{DynamicResource AppSurfaceBg}" TabStripPlacement="Top" Padding="0" KeyboardNavigation.TabNavigation="Continue">
   <TabItem Header="提示词" Style="{StaticResource ProductTab}">
    <Grid Margin="0,12,0,0" TextElement.Foreground="{DynamicResource AppTextPrimary}" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <DockPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="搜索" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppTextSecondary}"/><TextBox x:Name="PromptSearch" Style="{StaticResource Field}" TextChanged="PromptSearch_Changed" ToolTip="搜索标题、描述、正文和标签" AutomationProperties.Name="搜索提示词"/></DockPanel>

      <Button Grid.Column="2" Content="新建提示词" Style="{StaticResource SmallButton}" Foreground="{DynamicResource AppAccent}" Click="NewPrompt_Click"/>
     </Grid>
     <Expander Grid.Row="1" Header="按标签筛选 · 匹配任一已选标签" Margin="0,0,0,8" Foreground="{DynamicResource AppTextSecondary}">
      <StackPanel Margin="0,8,0,0">
       <DockPanel><Button DockPanel.Dock="Right" Content="清除筛选" Style="{StaticResource QuietButton}" Click="ClearTags_Click" Margin="8,0,0,0"/><TextBox x:Name="TagSearch" Style="{StaticResource Field}" TextChanged="TagSearch_Changed" AutomationProperties.Name="搜索标签"/></DockPanel>
       <ListBox x:Name="TagFilters" MaxHeight="88" SelectionMode="Multiple" SelectionChanged="TagFilters_Changed" BorderThickness="0" Background="Transparent" Margin="0,6,0,0" ItemContainerStyle="{StaticResource FilterTag}"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
      </StackPanel>
     </Expander>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="290"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource AppSubtleBorder}" BorderThickness="1" CornerRadius="4">
       <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{DynamicResource AppHeaderBg}" Padding="12,0"><TextBlock x:Name="PromptCount" Style="{StaticResource LibraryMeta}" VerticalAlignment="Center"/></Border>
        <ListBox x:Name="PromptList" Grid.Row="1" SelectionChanged="PromptList_SelectionChanged" PreviewMouseLeftButtonUp="PromptList_Click" PreviewKeyDown="PromptList_KeyDown" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="Prompts_ScrollChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource LibraryRow}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="提示词列表：单击复制，方向键选择，Enter 复制">
         <ListBox.ItemTemplate><DataTemplate>
          <Grid Height="58" Margin="12,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Title}" Style="{StaticResource LibraryListTitle}" ToolTip="{Binding Title}"/><TextBlock Text="{Binding ContentPreview}" Style="{StaticResource LibraryListSummary}" ToolTip="{Binding Content}"/></StackPanel>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Content="复制" Style="{StaticResource QuietButton}" Foreground="{DynamicResource AppAccent}" Tag="{Binding}" Click="CopyPrompt_Click" ToolTip="{Binding Title, StringFormat=复制完整提示词：{0}}"/>
            <TextBlock Text="{Binding CopyCount, StringFormat=已复制 {0} 次}" Style="{StaticResource LibraryMeta}" HorizontalAlignment="Center"/>
           </StackPanel>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PromptEmpty" Grid.Row="1" Text="还没有提示词，点击右上角新建。" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <Border x:Name="PromptDetail" Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=PromptList}" Style="{StaticResource SelectedDetail}">
       <Grid SizeChanged="PromptDetail_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="PromptHeader" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,0,10">
         <TextBlock Text="{Binding Title}" Style="{StaticResource LibraryDetailTitle}" ToolTip="{Binding Title}"/>
         <TextBlock Text="{Binding Description}" Style="{StaticResource LibraryDescription}" MaxHeight="66" TextTrimming="CharacterEllipsis" Margin="0,7,0,10" ToolTip="{Binding Description}"/>
          <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource DetailTag}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         </StackPanel>
        </ScrollViewer>
        <TextBox x:Name="PromptPreview" Grid.Row="1" Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12" BorderThickness="1" BorderBrush="{DynamicResource AppSubtleBorder}" Background="{DynamicResource AppSurfaceBg}" Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="15" FontWeight="Normal" TextBlock.LineHeight="26" TextBlock.LineStackingStrategy="BlockLineHeight" AutomationProperties.Name="完整提示词正文，可选中文字"/>
        <Grid x:Name="PromptActions" Grid.Row="2" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock x:Name="PromptCopyFeedback" Style="{StaticResource LibraryMeta}" Text="单击左侧条目复制 · ↑↓ 选择 · Enter 复制" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
         <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><Button Content="AI 整理" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="Summarize_Click" ToolTip="整理标题、描述和标签，正文不变"/><Button Content="编辑" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="EditPrompt_Click"/><Button Content="删除" Style="{StaticResource DeleteButton}" Tag="{Binding}" Click="DeletePrompt_Click"/></StackPanel>
          <Button x:Name="PromptCopyButton" Grid.Column="1" Content="复制全文" Style="{StaticResource SmallButton}" Foreground="{DynamicResource AppAccent}" Tag="{Binding}" Click="CopyPrompt_Click"/>
         </Grid>
        </Grid>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="模型资料" Style="{StaticResource ProductTab}">
    <Grid Margin="0,12,0,0" TextElement.Foreground="{DynamicResource AppTextPrimary}" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <DockPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="搜索" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppTextSecondary}"/><TextBox x:Name="ModelSearch" Style="{StaticResource Field}" TextChanged="ModelSearch_Changed" AutomationProperties.Name="搜索模型资料" ToolTip="搜索平台、地址、模型 ID 和备注"/></DockPanel>
      <Button Grid.Column="1" Content="新增连接资料" Style="{StaticResource SmallButton}" Foreground="{DynamicResource AppAccent}" Click="NewModel_Click"/>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="290"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource AppSubtleBorder}" BorderThickness="1" CornerRadius="4">
       <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="{DynamicResource AppHeaderBg}" Padding="12,0"><DockPanel LastChildFill="True"><TextBlock Text="拖拽排序" DockPanel.Dock="Right" Style="{StaticResource LibraryMeta}" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock x:Name="ModelCount" Style="{StaticResource LibraryMeta}" VerticalAlignment="Center"/></DockPanel></Border>
        <ListBox x:Name="ModelList" Grid.Row="1" ItemContainerStyle="{StaticResource LibraryRow}" SelectionChanged="ModelList_SelectionChanged" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="模型连接资料列表" AutomationProperties.HelpText="按住条目拖动，松开后自动保存顺序" AllowDrop="True" PreviewMouseLeftButtonDown="ModelList_PreviewMouseLeftButtonDown" PreviewMouseMove="ModelList_PreviewMouseMove" PreviewMouseLeftButtonUp="ModelList_PreviewMouseLeftButtonUp" DragOver="ModelList_DragOver" DragLeave="ModelList_DragLeave" Drop="ModelList_Drop">
         <ListBox.ItemTemplate><DataTemplate>
          <Grid Height="58" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="⠿" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="按住拖动以排序"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Platform}" Style="{StaticResource LibraryListTitle}" ToolTip="{Binding Platform}"/><TextBlock Text="{Binding Model}" Style="{StaticResource LibraryListSummary}" FontFamily="{StaticResource LibraryCodeFont}" ToolTip="{Binding Endpoint}"/></StackPanel>
           <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Style="{StaticResource LibraryMeta}" VerticalAlignment="Center"/>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ModelEmpty" Grid.Row="1" Text="还没有连接资料，点击右上角新增。" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
       </Grid>
      </Border>
      <Border x:Name="ModelDetail" Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=ModelList}" Style="{StaticResource SelectedDetail}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Platform}" Style="{StaticResource LibraryDetailTitle}" ToolTip="{Binding Platform}"/><TextBlock Text="{Binding TypeLabel}" Style="{StaticResource LibraryMeta}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,4,8,10">
         <TextBlock Text="模型列表 · 下拉选择即复制" Style="{StaticResource LibraryFieldLabel}" Margin="0,0,0,2"/>
         <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ModelCatalog" ItemsSource="{Binding ModelIds}" SelectedIndex="-1" Tag="{Binding}" SelectionChanged="ModelId_Selected" ToolTip="选择即复制模型 ID，不改变固定模型" AutomationProperties.Name="选择并复制模型 ID" IsTextSearchEnabled="True" MaxDropDownHeight="300"/>
          <Button Grid.Column="1" Content="获取 / 更新列表" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="RefreshModels_Click" Margin="8,0,0,0"/>
         </Grid>
         <TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource LibraryMeta}" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="ModelDetailScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,8,0">
          <TextBlock Text="API 地址" Style="{StaticResource LibraryFieldLabel}" Margin="0,4,0,5"/>
          <TextBlock Text="{Binding Endpoint}" Style="{StaticResource LibraryData}"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,6"><Button Content="复制地址" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="CopyEndpoint_Click" Margin="0"/><Button Content="复制 Key" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="CopyKey_Click" ToolTip="{Binding KeyLabel}"/></StackPanel>
          <TextBlock Text="默认复制模型 ID" Style="{StaticResource LibraryFieldLabel}"/>
          <TextBlock x:Name="CopyModelId" Text="{Binding ModelIdToCopy}" Style="{StaticResource LibraryData}"/>
          <Button Content="复制模型 ID" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="CopyModel_Click" ToolTip="复制此连接上一次成功复制的模型 ID；尚无记录时使用固定模型 ID" HorizontalAlignment="Left" Margin="0,5,0,6"/>
          <TextBlock Text="手记余额" Style="{StaticResource LibraryFieldLabel}"/><TextBlock Text="{Binding RemainingBalance}" Style="{StaticResource LibraryBody}"/>
          <TextBlock Text="备注" Style="{StaticResource LibraryFieldLabel}"/><TextBlock Text="{Binding Note}" Style="{StaticResource LibraryBody}"/>
         </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="克隆" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="CloneModel_Click"/><Button Content="编辑" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="EditModel_Click"/><Button Content="删除" Style="{StaticResource DeleteButton}" Tag="{Binding}" Click="DeleteModel_Click"/></StackPanel>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" Padding="10,5" Margin="0,8,0,0" Background="{DynamicResource AppHeaderBg}" CornerRadius="4">
   <TextBlock x:Name="Status" Text="单击提示词复制，右侧查看全文；模型列表下拉选择即复制。" Style="{StaticResource LibraryMeta}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" MinHeight="18" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Border x:Name="SaveNotice" Grid.RowSpan="4" Panel.ZIndex="1" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="680" Margin="24,4,24,0" Padding="16,12" Background="{DynamicResource AppAccentSubtle}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="6">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="✓" Foreground="{DynamicResource AppAccent}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <TextBlock x:Name="SaveNoticeText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}" AutomationProperties.LiveSetting="Polite"/>
    <Button Grid.Column="2" Content="关闭" Style="{StaticResource QuietButton}" Click="DismissSaveNotice_Click" Margin="12,0,0,0" AutomationProperties.Name="关闭保存提示"/>
   </Grid>
  </Border>
  <Border x:Name="EditorLayer" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource AppSurfaceBg}" Padding="20,8,20,0" KeyboardNavigation.TabNavigation="Cycle">
   <Grid MaxWidth="760"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10"><TextBlock x:Name="EditorTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="修改后点击保存，取消则保留原有资料。" Style="{StaticResource ProductHint}" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
     <StackPanel x:Name="PromptEditor" Visibility="Collapsed">
      <TextBlock Text="标题" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="PromptTitle" Style="{StaticResource Field}" AutomationProperties.Name="提示词标题" ToolTip="留空时从正文生成标题"/>
      <TextBlock Text="描述" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="PromptDescription" Style="{StaticResource Field}" AutomationProperties.Name="提示词描述"/>
      <TextBlock Text="标签 · 用中英文逗号分隔，最多 12 个" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="PromptTags" Style="{StaticResource Field}" AutomationProperties.Name="提示词标签"/>
      <TextBlock Text="提示词正文 · 必填" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="PromptBody" Style="{StaticResource MultilineField}" MinHeight="210" AcceptsTab="True" AutomationProperties.Name="提示词正文" TextChanged="PromptBody_Changed"/>
      <TextBlock x:Name="CharacterCount" Margin="0,7,0,0" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
     </StackPanel>
     <StackPanel x:Name="ModelEditor" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="平台" Style="{StaticResource LibraryLabel}"/><ComboBox x:Name="PlatformBox" Style="{StaticResource EditablePlatform}" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="Platform_Changed" LostKeyboardFocus="Platform_LostFocus" AutomationProperties.Name="平台名称" ToolTip="可直接输入自定义平台名称"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="模型类型" Style="{StaticResource LibraryLabel}"/><ComboBox x:Name="TypeBox" SelectedValuePath="Key" SelectionChanged="Type_Changed" AutomationProperties.Name="模型类型"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      </Grid>
      <TextBlock x:Name="PlatformHint" Style="{StaticResource ProductHint}" Margin="0,10,0,0"/>
      <TextBlock Text="API 基础地址" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="EndpointBox" Style="{StaticResource Field}" TextChanged="Endpoint_Changed" AutomationProperties.Name="API 基础地址"/>
      <CheckBox x:Name="ModelInsecure" Content="允许远程 HTTP（API Key 未加密传输）" Margin="0,8,0,4" Checked="ModelInsecure_Changed" Unchecked="ModelInsecure_Changed" ToolTip="仅对当前连接生效。HTTPS 和本机 HTTP 无需开启；更换服务器后需重新确认。"/>
      <TextBlock x:Name="KeyHint" Text="API Key" Style="{StaticResource LibraryLabel}"/><PasswordBox x:Name="ModelKey" PasswordChanged="ModelKey_Changed" AutomationProperties.Name="连接 API Key"/>
      <TextBlock Text="固定模型 ID（可留空）" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="ModelBox" Style="{StaticResource Field}" AutomationProperties.Name="固定模型 ID" ToolTip="可留空，仅保存连接资料；也可手动填写或从下方模型列表中选择"/>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="EditorModelIds" SelectionChanged="EditorModelId_Selected" MaxDropDownHeight="220" IsTextSearchEnabled="True" AutomationProperties.Name="选择固定模型并复制 ID" ToolTip="选择模型后填入上方固定模型 ID，并复制到剪贴板"/>
       <Button x:Name="EditorFetchButton" Grid.Column="1" Content="获取模型列表" Style="{StaticResource SmallButton}" Click="EditorFetch_Click" Margin="12,0,0,0"/>
      </Grid>
      <TextBlock Text="手记余额" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="BalanceBox" Style="{StaticResource Field}" AutomationProperties.Name="手记余额"/>
      <TextBlock Text="备注" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="NoteBox" Style="{StaticResource MultilineField}" MinHeight="80" AutomationProperties.Name="连接备注"/>
     </StackPanel>
     <StackPanel x:Name="AiEditor" Visibility="Collapsed">
      <TextBlock Text="AI 仅整理标题、描述和标签，保留完整正文。" Style="{StaticResource ProductHint}" Margin="0,10,0,4"/>
      <TextBlock Text="OpenAI 兼容 API 基础地址" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="AiEndpoint" Style="{StaticResource Field}" AutomationProperties.Name="AI 整理 API 地址"/>
      <TextBlock Text="模型 ID" Style="{StaticResource LibraryLabel}"/><TextBox x:Name="AiModel" Style="{StaticResource Field}" AutomationProperties.Name="AI 整理模型 ID"/>
      <TextBlock Text="API Key · 留空保留同源地址已有 Key" Style="{StaticResource LibraryLabel}"/><PasswordBox x:Name="AiKey" AutomationProperties.Name="AI 整理 API Key"/>
      <CheckBox x:Name="AiAutomatic" Content="新建提示词后自动整理" Margin="0,24,0,8"/>
      <TextBlock Text="开启后会将提示词前 12000 字符发送给以上服务，可能消耗服务额度。" Style="{StaticResource ProductHint}" Margin="0,0,0,18"/>
      <CheckBox x:Name="AiInsecure" Content="允许远程 HTTP 接口（未加密传输）" Margin="0,0,0,10"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <ProgressBar x:Name="EditorSaveProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" Foreground="{DynamicResource AppAccent}" AutomationProperties.Name="正在保存资料"/>
      <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Ctrl+Enter 保存 · Esc 取消" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelEditorButton" Content="取消" Style="{StaticResource ProductSecondaryButton}" Click="CancelEditor_Click"/><Button x:Name="SaveButton" Content="保存" MinWidth="88" Style="{StaticResource ProductButton}" Click="SaveEditor_Click" Margin="12,0,0,0"/></StackPanel>
     </Grid>
    </Grid>
   </Grid>
  </Border>
  <Popup x:Name="CopyToast" Placement="Top" StaysOpen="True" AllowsTransparency="True" Focusable="False" IsHitTestVisible="False" HorizontalOffset="8" VerticalOffset="-6" PopupAnimation="None">
   <Border x:Name="CopyToastBorder" Padding="12,8" Background="{DynamicResource AppSurfaceBg}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="5" MaxWidth="360">
    <TextBlock x:Name="CopyToastText" Foreground="{DynamicResource AppAccent}" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </Border>
  </Popup>
 </Grid></Grid>
</Window>
