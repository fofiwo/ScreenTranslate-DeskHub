<UserControl x:Class="OverTranslate.Views.Settings.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:OverTranslate.Views.Settings">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,24,16,24" MaxWidth="760" HorizontalAlignment="Stretch">
   <TextBlock Text="快捷键与高级" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <TextBlock Text="点击快捷键输入框，再按键盘组合；Esc 取消。更改后立即保存。" TextWrapping="Wrap" Style="{StaticResource ProductHint}" Margin="0,0,0,14"/>
   <StackPanel x:Name="HotkeyRows"/>
   <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}" Margin="0,8,0,14"/>
   <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,10"/>
   <Button x:Name="SaveRetryBtn" Content="重试保存" Visibility="Collapsed" HorizontalAlignment="Left" Click="RetrySave_Click" Margin="0,0,0,14"/>
   <Border Height="1" Background="{DynamicResource AppBorder}" Margin="0,8,0,20"/>
   <CheckBox x:Name="PreserveFormattingCheckBox" Content="保留原文格式（独立 OCR）" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,8"/>
   <TextBlock Text="开启时保留换行、段落、缩进、列表和表格文本行列；关闭时整理断行与空白，保留原文用词。" TextWrapping="Wrap" Style="{StaticResource ProductHint}" Margin="24,0,0,18"/>
   <CheckBox x:Name="AllowFallbackCheckBox" Content="允许备用服务" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,8"/>
   <TextBlock Text="默认关闭，只请求选定服务。开启后允许现有内置服务备用链；OpenAI 和 DeepL 不跨服务回退。截图和持续翻译会标明实际服务。" TextWrapping="Wrap" Style="{StaticResource ProductHint}" Margin="24,0,0,18"/>
   <CheckBox x:Name="AutoTranslateCheckBox" Content="框选后自动翻译" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,14"/>
   <CheckBox x:Name="LiveOverlayCheckBox" Content="截图译文原位覆盖" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,14"/>
   <CheckBox x:Name="StartupCheckBox" Content="开机启动（可选，默认关闭）" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,0,0,14"/>
   <Expander Header="高级：竖排与漫画" Margin="0,8,0,18">
    <StackPanel Margin="0,16,0,0">
     <CheckBox x:Name="VerticalCheckBox" Content="截图翻译使用竖排识别（默认横排）" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,14"/>
     <CheckBox x:Name="MangaCheckBox" Content="使用漫画竖排模型" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,14"/>
     <ctl:MangaModelCard/>
    </StackPanel>
   </Expander>
   <Expander Header="高级：手动诊断" Margin="0,0,0,18">
    <StackPanel Margin="0,16,0,0">
     <CheckBox x:Name="VerboseCheckBox" Content="记录详细日志（可能包含识别文字）" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,14"/>
     <Button x:Name="ExportDiagnosticsBtn" Content="导出诊断包" Click="ExportDiagnostics_Click" Style="{StaticResource ProductSecondaryButton}" HorizontalAlignment="Left"/>
     <TextBlock x:Name="DiagnosticsResult" TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource ProductHint}"/>
    </StackPanel>
   </Expander>
   <TextBlock Text="界面：浅色 · 简体中文；不影响文字识别和翻译的语言范围。" Style="{StaticResource ProductHint}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
