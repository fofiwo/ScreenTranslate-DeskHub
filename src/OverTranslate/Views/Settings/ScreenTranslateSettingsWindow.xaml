<Window x:Class="OverTranslate.Views.Settings.ScreenTranslateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverTranslate.Views.Settings"
        xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
        Title="ScreenTranslate · 文字识别" Width="740" Height="760" WindowStartupLocation="CenterOwner"
        Style="{StaticResource ProductToolWindow}" Background="{DynamicResource AppSurfaceBg}">
    <DockPanel LastChildFill="True" Background="{DynamicResource AppSurfaceBg}">
        <controls:ToolWindowHeader DockPanel.Dock="Top"/>
        <local:OcrSettingsPage x:Name="Page"/>
    </DockPanel>
</Window>
