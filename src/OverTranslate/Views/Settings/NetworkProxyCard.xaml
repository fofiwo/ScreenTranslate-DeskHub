<UserControl x:Class="OverTranslate.Views.Settings.NetworkProxyCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource AppTextPrimary}" Background="{DynamicResource AppWindowBg}" FontSize="13">
 <Border Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource AppBorder}" Background="{DynamicResource AppWindowBg}">
  <StackPanel>
   <TextBlock Text="网络代理" Style="{StaticResource ProductSectionTitle}"/>
   <CheckBox x:Name="EnabledBox" Content="启用自定义代理" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"/>
   <TextBlock Text="代理地址" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,6"/>
   <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}" Height="36"
            VerticalContentAlignment="Center" AutomationProperties.Name="网络代理地址"
            ToolTip="例如 http://127.0.0.1:10808 或 socks5://127.0.0.1:10808"/>
   <TextBlock Text="支持 HTTP、HTTPS、SOCKS5，不支持在地址中填写账号密码。" TextWrapping="Wrap" Style="{StaticResource ProductHint}" Margin="0,6,0,12"/>
   <TextBlock Text="使用此代理的功能" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <StackPanel x:Name="FeatureRows"/>
   <WrapPanel Margin="0,4,0,8">
    <Button x:Name="SaveButton" Content="保存并应用" Click="Save_Click" Style="{StaticResource ProductSecondaryButton}" Margin="0,0,8,0"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource ProductHint}"/>
   <TextBlock Text="保存后对后续请求生效。未勾选的功能和关闭代理时使用系统默认网络；已发出的请求继续完成。localhost / 本机模型、局域网同步直接连接；外部浏览器与 Windows 管理的下载由各自的网络设置控制。启用后代理不可用会报错，不会自动改为直连。" TextWrapping="Wrap" Style="{StaticResource ProductHint}" Margin="0,8,0,0"/>
  </StackPanel>
 </Border>
</UserControl>
