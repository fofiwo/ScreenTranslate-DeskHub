<Window x:Class="OverTranslate.Views.ClipboardHistory.ClipboardHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="剪贴板历史" Width="560" Height="700" MinWidth="460" MinHeight="400"
 WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
 Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}"
 FontFamily="{DynamicResource AppFont}" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown"
 AllowDrop="True" PreviewDragOver="Sync_DragOver" PreviewDrop="Sync_Drop">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="ClipboardMenuItem" TargetType="MenuItem">
   <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
   <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <CheckBox x:Name="Switch" Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource ToggleSwitch}" Visibility="Collapsed"
       IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Focusable="False" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsCheckable" Value="True"><Setter TargetName="Switch" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AppAccentSubtle}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AppAccentSubtle}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClipboardMenu" TargetType="ContextMenu">
   <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
   <Setter Property="Background" Value="{DynamicResource AppCardBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
   <Setter Property="MinWidth" Value="292"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
     <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource ClipboardMenuItem}"/>
    <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
    <Border Height="1" Background="{DynamicResource AppBorderSubtle}" Margin="14,6"/>
   </ControlTemplate></Setter.Value></Setter></Style></Style.Resources>
  </Style>
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="2,0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/><Setter Property="Foreground" Value="{DynamicResource AppAccent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RecordPinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/><Setter Property="Foreground" Value="{DynamicResource AppAccent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <DataTrigger Binding="{Binding Record.IsPinned}" Value="True">
      <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ProductHeroBg}"/>
      <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ProductWarmFg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ProductHeroFg}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
     </DataTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding Record.IsPinned}" Value="True"><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource AppWindowBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8,12,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Header_Drag"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="剪贴板" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="RecordingHint" Text="剪贴板历史" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="10,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="ClearUnpinnedButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="ClearUnpinned_Click" ToolTip="清空未置顶历史及保存的内容（不受筛选影响，保留源文件和置顶记录）" AutomationProperties.Name="清空未置顶记录"/>
     <Button x:Name="WindowPinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="WindowPin_Click" ToolTip="固定窗口：失焦后保持显示" AutomationProperties.Name="固定窗口"/>
     <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Menu_Click" ToolTip="剪贴板设置与同步" AutomationProperties.Name="剪贴板设置与同步">
      <Button.ContextMenu><ContextMenu Style="{StaticResource ClipboardMenu}" Placement="Bottom" HorizontalOffset="-244" VerticalOffset="6">
       <MenuItem x:Name="AutoPasteMenuItem" Header="点击后自动粘贴" IsCheckable="True" StaysOpenOnClick="True" Click="BehaviorSetting_Click" ToolTip="开启后回到原输入框粘贴；关闭后仅复制"/>
       <MenuItem x:Name="RecordHistoryMenuItem" Header="记录剪贴板历史" IsCheckable="True" StaysOpenOnClick="True" Click="BehaviorSetting_Click" ToolTip="暂停后不记录新内容，已有历史保留"/>
       <Separator/>
       <MenuItem x:Name="ImportMenuItem" Header="导入 Windows 系统历史" Click="Import_Click"/>
       <MenuItem Header="快捷键设置" Click="ShortcutSettings_Click"/>
       <MenuItem Header="设备与同步…" Click="SyncSettings_Click"/>
       <MenuItem Header="同步记录…" Click="SyncHistory_Click"/>
       <Separator/><MenuItem Header="恢复默认位置与大小" Click="ResetPlacement_Click"/><MenuItem Header="打开历史数据目录" Click="OpenFolder_Click"/>
      </ContextMenu></Button.ContextMenu>
     </Button>
     <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Hide_Click" ToolTip="收起（Esc）" AutomationProperties.Name="收起剪贴板"/>
    </StackPanel>
   </Grid>
   <Border x:Name="SearchPanel" Grid.Row="1" Height="42" Background="{DynamicResource AppHeaderBg}" CornerRadius="10" Margin="0,3,0,3" Padding="10,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
     <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Filter_Changed" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource AppTextPrimary}" AutomationProperties.Name="搜索剪贴板"/>
     <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索内容、来源或文件名…" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
     <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE894;" Click="ClearSearch_Click" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"/>
    </Grid>
   </Border>
   <ListBox x:Name="TypeFilter" Grid.Row="2" SelectedIndex="0" SelectionChanged="Filter_Changed" Background="Transparent" BorderThickness="0"
    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="剪贴板分类">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,3,4,3"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AppAccentSubtle}"/><Setter Property="Foreground" Value="{DynamicResource AppAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AppAccentSubtle}"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBoxItem Content="全部"/><ListBoxItem Content="文本"/><ListBoxItem Content="图片"/><ListBoxItem Content="链接"/><ListBoxItem Content="文件"/><ListBoxItem Content="代码"/><ListBoxItem Content="富文本"/>
    <ListBoxItem x:Name="SyncTab" Content="设备与同步"/>
   </ListBox>
   <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4,0,4,6" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" AutomationProperties.LiveSetting="Polite"/>
    <Grid x:Name="SyncPanel" Grid.Row="4" Visibility="Collapsed" Background="Transparent" Margin="4,4,4,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SendPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
     <StackPanel><StackPanel>
      <DockPanel>
       <Button x:Name="SyncHistoryButton" Content="记录" DockPanel.Dock="Right" Style="{StaticResource ProductLink}" Click="SyncHistory_Click" Margin="8,0,0,0" ToolTip="查看进度、历史记录、重试与接收目录"/>
       <Button x:Name="SyncDeviceStatusButton" Style="{StaticResource ProductLink}" Click="SyncSettings_Click" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Height="Auto" MinHeight="40" Padding="4,4" ToolTip="查看设备连接、同步开关和自动重连状态">
        <TextBlock x:Name="SyncConnectionText" Text="同步 · 设备未连接" TextWrapping="Wrap" FontSize="12"/>
       </Button>
      </DockPanel>
      <TextBlock x:Name="SyncSummaryText" Margin="2,6,2,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar x:Name="SyncProgress" Height="4" Margin="2,6,2,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
     </StackPanel>
      <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="发送文件或文件夹" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <StackPanel Grid.Row="1">
        <TextBlock Text="接收设备" Margin="0,0,0,6"/>
        <Grid>
         <ComboBox x:Name="SendRecipientBox" Style="{StaticResource ModernComboBox}" MinHeight="40" SelectionChanged="SendRecipient_Changed" AutomationProperties.Name="选择接收设备">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
         </ComboBox>
         <TextBlock x:Name="SendRecipientEmpty" Text="暂无在线设备" Foreground="{DynamicResource AppTextSecondary}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
       </StackPanel>
       <TextBlock x:Name="SendConnectionHint" Grid.Row="2" Style="{StaticResource ProductHint}" Margin="0,6,0,12" AutomationProperties.LiveSetting="Polite"/>
       <WrapPanel Grid.Row="3" Margin="0,0,0,8">
        <Button x:Name="AddSendFilesButton" Content="添加文件" Style="{StaticResource ProductSecondaryButton}" Click="AddSendFiles_Click"/>
        <Button x:Name="AddSendFoldersButton" Content="添加文件夹" Style="{StaticResource ProductSecondaryButton}" Click="AddSendFolders_Click" Margin="8,0,0,0"/>
        <Button x:Name="ClearSendSourcesButton" Content="清空" Style="{StaticResource ProductLink}" Click="ClearSendSources_Click" Margin="8,0,0,0" ToolTip="清空待发送列表，保留源文件"/>
       </WrapPanel>
       <Border Grid.Row="4" MinHeight="140" Background="{DynamicResource AppHeaderBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
         <ListBox x:Name="SendSourceList" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" BorderThickness="0" Padding="8" MaxHeight="240" ItemContainerStyle="{StaticResource ProductListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="待发送文件和文件夹">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <StackPanel x:Name="SendDropHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" IsHitTestVisible="False">
          <TextBlock Text="拖入文件或文件夹" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock Text="保留文件夹结构与空文件夹" Style="{StaticResource ProductHint}" Margin="0,8,0,0" TextAlignment="Center"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
     </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="1">
      <TextBlock x:Name="SendSelectionHint" Text="可拖入到此页任意位置，也可点击添加。" Style="{StaticResource ProductHint}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      <DockPanel>
       <Button x:Name="SendFilesButton" DockPanel.Dock="Right" Content="发送" Style="{StaticResource ProductButton}" Click="SendToDevice_Click" MinWidth="96" Margin="12,0,0,0"/>
       <Button x:Name="CancelInlineSendButton" DockPanel.Dock="Right" Content="取消传输" Style="{StaticResource ProductSecondaryButton}" Click="CancelInlineSend_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
       <TextBlock Text="对方确认并选择保存目录后传输" Style="{StaticResource ProductHint}" VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
    </Grid>
   <Grid x:Name="HistoryPanel" Grid.Row="4">
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
     PreviewMouseLeftButtonUp="History_Click" AutomationProperties.Name="剪贴板历史记录">
     <ListBox.ContextMenu><ContextMenu Style="{StaticResource ClipboardMenu}" Opened="RecordMenu_Opened">
      <MenuItem Header="复制并收起" Click="CopyMenu_Click"/><MenuItem Header="粘贴到原应用" Click="Paste_Click"/>
      <MenuItem x:Name="SendRecordMenuItem" Header="发送文件到设备…" Click="SendRecord_Click"/>
      <Separator/><MenuItem x:Name="PinMenuItem" Header="置顶 / 取消置顶" Click="PinMenu_Click"/><MenuItem Header="预览完整内容" Click="PreviewMenu_Click"/>
      <Separator/><MenuItem Header="删除这条记录" Click="DeleteMenu_Click"/>
     </ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Card" Background="{DynamicResource AppHeaderBg}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,7,8,9"><ContentPresenter/></Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppBorder}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel>
       <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding FileKind}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
         <Button Content="&#xE724;" Tag="send" Click="CardAction_Click" ToolTip="发送到设备" AutomationProperties.Name="发送文件到设备" Width="26" Height="24">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFiles}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
         </Button>
         <Button Style="{StaticResource IconButton}" Content="&#xE890;" Tag="preview" Click="CardAction_Click" ToolTip="预览完整内容" AutomationProperties.Name="预览完整内容" Width="26" Height="24"/>
         <Button Style="{StaticResource RecordPinButton}" Content="&#xE718;" Tag="pin" Click="CardAction_Click" ToolTip="{Binding Record.PinLabel}" AutomationProperties.Name="{Binding Record.PinLabel}" Width="26" Height="24"/>
         <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Tag="delete" Click="CardAction_Click" ToolTip="{Binding DeleteHint}" AutomationProperties.Name="删除记录" Width="26" Height="24"/>
         <TextBlock Text="{Binding TimeLabel}" ToolTip="{Binding Record.ExactTime}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" Margin="6,0,0,0"/>
        </StackPanel>
       </Grid>
       <Border Background="{DynamicResource AppAccentSubtle}" CornerRadius="6" Padding="8,5" Margin="0,0,0,5" HorizontalAlignment="Left" ToolTip="{Binding FilePaths}">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding HasFolders}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBlock Text="{Binding FolderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
        </StackPanel>
       </Border>
       <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" LineHeight="18"/>
       <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="65" MaxWidth="340" HorizontalAlignment="Left"
        ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000" AutomationProperties.Name="图片缩略图，悬停放大查看">
        <Image.ToolTip>
         <ToolTip Placement="Mouse" Opened="ImagePreview_Opened" Closed="ImagePreview_Closed" Padding="8"
          Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" HasDropShadow="True">
          <Image Stretch="Uniform" MaxWidth="640" MaxHeight="480"/>
         </ToolTip>
        </Image.ToolTip>
        </Image>
        <TextBlock Text="{Binding Record.SourceLabel}" ToolTip="{Binding Record.SourceLabel}" FontSize="11"
         Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
          <DataTrigger Binding="{Binding Record.SourceLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="16">
     <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
     <TextBlock x:Name="EmptyTitle" Text="还没有剪贴板记录" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="EmptyHint" Text="复制内容后会自动出现在这里" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="HistoryFooter" Grid.Row="5" Height="19" Margin="4,5,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ActionHint" Text="点击 / Enter 粘贴 · Esc 收起" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
    <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
   </Grid>
   <Border x:Name="PreviewPanel" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="ClosePreview_Click" ToolTip="返回列表" AutomationProperties.Name="返回列表"/>
       <StackPanel><TextBlock x:Name="DetailHint" Text="完整预览" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailSource" Margin="0,4,8,0" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
       </StackPanel>
      </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="360"/>
      <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" AutomationProperties.Name="剪贴板完整预览"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
