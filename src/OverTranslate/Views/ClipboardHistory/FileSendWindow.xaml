<Window x:Class="OverTranslate.Views.ClipboardHistory.FileSendWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
 Title="发送到设备" Width="520" Height="520" MinWidth="440" MinHeight="480" WindowStartupLocation="CenterOwner" Style="{StaticResource ProductToolWindow}"
 Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}">
 <DockPanel><controls:ToolWindowHeader DockPanel.Dock="Top"/>
 <Border Padding="24" Background="{DynamicResource AppWindowBg}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="发送文件或文件夹" Style="{StaticResource ProductDialogTitle}"/>
   <TextBlock Text="对方选择保存目录并确认后开始传输，保留文件夹结构与空文件夹。" Style="{StaticResource ProductHint}" Margin="0,8,0,16"/>
   <TextBlock Text="接收方" Margin="0,0,0,6" FontWeight="SemiBold"/>
   <ComboBox x:Name="RecipientBox" Style="{StaticResource ModernComboBox}" Height="40" AutomationProperties.Name="选择接收设备" SelectionChanged="Recipient_Changed">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBlock x:Name="ConnectionHint" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource AppTextSecondary}"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
   <Button Content="添加文件" Style="{StaticResource ProductSecondaryButton}" Click="AddFiles_Click"/>
   <Button Content="添加文件夹" Style="{StaticResource ProductSecondaryButton}" Click="AddFolder_Click" Margin="8,0,0,0"/>
   <Button Content="清空" ToolTip="清空待发送项目" Style="{StaticResource ProductLink}" Click="Clear_Click" Margin="8,0,0,0"/>
  </WrapPanel>
  <ListBox x:Name="SourceList" Grid.Row="2" Background="{DynamicResource AppCardBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" ItemContainerStyle="{StaticResource ProductListItem}" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="待发送项目">
   <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock x:Name="SelectionHint" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource AppTextSecondary}"/>
   <DockPanel><Button Content="设备与同步…" DockPanel.Dock="Left" HorizontalAlignment="Left" Style="{StaticResource ProductSecondaryButton}" Click="Setup_Click"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Style="{StaticResource ProductSecondaryButton}"/>
     <Button x:Name="SendButton" Content="发送" IsDefault="True" Style="{StaticResource ProductButton}" Margin="8,0,0,0" Click="Send_Click"/></StackPanel>
   </DockPanel>
  </StackPanel>
 </Grid></Border>
 </DockPanel>
</Window>
