<UserControl x:Class="OverTranslate.Views.ClipboardHistory.FileReceiveCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource AppAccentSubtle}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
  <StackPanel>
   <TextBlock Text="收到文件请求" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="OfferText" TextWrapping="Wrap" LineHeight="22"/>
   </ScrollViewer>
   <TextBlock x:Name="RemainingText" Style="{StaticResource ProductHint}" Margin="0,6,0,0"/>
   <TextBlock Text="保存位置" FontWeight="SemiBold" Margin="0,12,0,4"/>
   <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="FolderText" Text="请先选择保存目录" TextWrapping="Wrap"/>
   </ScrollViewer>
   <Button x:Name="ChooseFolderButton" Content="选择保存目录…" Style="{StaticResource ProductSecondaryButton}" Click="Folder_Click" HorizontalAlignment="Left" Margin="0,8,0,8"/>
   <TextBlock Text="确认前不会接收文件。将在所选目录中新建本批文件夹，保留原目录结构。" Style="{StaticResource ProductHint}"/>
   <TextBlock x:Name="ErrorText" Style="{StaticResource ProductInlineError}" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
    <Button x:Name="RejectButton" Content="拒绝" Style="{StaticResource ProductSecondaryButton}" Click="Reject_Click" Margin="0,0,8,0"/>
    <Button x:Name="AcceptButton" Content="接收" Style="{StaticResource ProductButton}" IsEnabled="False" Click="Accept_Click"/>
   </WrapPanel>
  </StackPanel>
 </Border>
</UserControl>
