<Window x:Class="OverTranslate.Views.ClipboardHistory.LanTransferWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="局域网同步与文件传输 · ScreenTranslate" Width="880" Height="790" MinWidth="760" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppWindowBg}"
 Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="13"
 UseLayoutRounding="True" Closing="Window_Closing">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="24">
  <DockPanel><Button DockPanel.Dock="Right" Content="断开连接" Style="{StaticResource ProductSecondaryButton}" Click="Disconnect_Click"/>
   <StackPanel><TextBlock Text="局域网同步与文件传输" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Windows 电脑之间 · 一次配对，同步剪贴板与资料库" Margin="0,8,0,0" Foreground="{DynamicResource AppTextSecondary}"/></StackPanel>
  </DockPanel>
  <TextBlock x:Name="ConnectionStatus" Text="尚未连接。任选一台等待配对，另一台填写它的地址和配对码。" Margin="0,18,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
   <StackPanel>
    <TextBlock Text="在这台电脑等待配对" FontWeight="SemiBold"/>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="LocalAddressBox" Style="{StaticResource ModernComboBox}" MinHeight="36" AutomationProperties.Name="本机局域网地址"/>
     <Button x:Name="ListenButton" Grid.Column="2" Content="等待配对" Style="{StaticResource ProductSecondaryButton}" Click="Listen_Click"/>
    </Grid>
    <TextBox x:Name="PairingInfo" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" Margin="0,10,0,0" Text="开始等待后显示地址和配对码。" AutomationProperties.Name="本机配对信息" CommandManager.PreviewExecuted="PairingInfo_PreviewExecuted"/>
   </StackPanel>
  </Border>
  <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="或连接另一台电脑" FontWeight="SemiBold"/>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="对方地址（IPv4:端口）" Margin="0,0,0,6"/><TextBox x:Name="RemoteAddressBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="对方局域网地址"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="对方的完整配对码" Margin="0,0,0,6"/><TextBox x:Name="PairCodeBox" Style="{StaticResource ModernTextBox}" MaxLength="40" AutomationProperties.Name="对方配对码"/></StackPanel>
     <Button x:Name="ConnectButton" Grid.Column="4" Content="连接" Style="{StaticResource ProductSecondaryButton}" Click="Connect_Click" VerticalAlignment="Bottom"/>
    </Grid>
    <TextBlock Text="配对在本次运行内有效；对方需确认。若 Windows 提示防火墙访问，请仅允许专用网络。" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}"/>
   </StackPanel>
  </Border>
  <CheckBox x:Name="AutoSyncBox" Content="自动同步新复制的文本和图片" Margin="0,16,0,12" Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"/>
  <TextBlock x:Name="ClipboardStatus" Text="未连接，剪贴板仅保存在本机。" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <CheckBox x:Name="LibrarySyncBox" Content="同步提示词库和模型库（包括 API Key）" Margin="0,0,0,8" Checked="LibrarySync_Changed" Unchecked="LibrarySync_Changed"/>
  <TextBlock Text="仅与自己的可信电脑配对。首次合并两端已有资料；后续新增、修改、删除自动同步，同时修改保留冲突副本。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,8"/>
  <TextBlock x:Name="LibraryStatus" Text="资料库同步尚未开启。" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="文件接收文件夹" FontWeight="SemiBold"/>
  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="ReceiveFolderBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="文件接收文件夹"/>
   <Button Grid.Column="1" Content="选择…" Style="{StaticResource ProductSecondaryButton}" Click="ChooseFolder_Click" Margin="8,0,0,0"/>
   <Button Grid.Column="2" Content="保存" Style="{StaticResource ProductSecondaryButton}" Click="SaveFolder_Click" Margin="8,0,0,0"/>
  </Grid>
  <Border x:Name="DropArea" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" Background="{DynamicResource AppAccentSubtle}"
   BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,16,0,0">
   <StackPanel HorizontalAlignment="Center"><TextBlock Text="将文件拖到这里，发送到已配对电脑" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="支持多个文件；同名文件自动改名，保留已有文件。" Margin="0,8,0,12" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button x:Name="ChooseFilesButton" Content="选择文件发送" Style="{StaticResource ProductButton}" Click="ChooseFiles_Click"/>
     <Button x:Name="CancelFilesButton" Content="取消传输" Style="{StaticResource ProductSecondaryButton}" Click="CancelFiles_Click" Margin="8,0,0,0" IsEnabled="False"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <TextBlock x:Name="TransferStatus" Margin="0,12,0,6" TextWrapping="Wrap" Text="配对后即可发送文件。" AutomationProperties.LiveSetting="Polite"/>
  <ProgressBar x:Name="TransferProgress" Height="6" Minimum="0" Maximum="100"/>
  <ListBox x:Name="TransferLog" MaxHeight="120" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="本次传输结果"/>
  <TextBlock Text="关闭此窗口后连接继续；退出程序或断开连接将停止同步和传输。" Margin="0,12,0,0" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
 </StackPanel>
 </ScrollViewer>
</Window>
