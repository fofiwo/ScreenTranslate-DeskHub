<Window x:Class="OverTranslate.Views.ClipboardHistory.FileReceiveWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
 Title="接收文件" Width="520" MaxHeight="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Style="{StaticResource ProductToolWindow}"
 Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}" FontFamily="{DynamicResource AppFont}">
 <DockPanel><controls:ToolWindowHeader DockPanel.Dock="Top"/>
 <Border Padding="24" Background="{DynamicResource AppWindowBg}"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="收到文件请求" Style="{StaticResource ProductDialogTitle}"/>
  <ScrollViewer Grid.Row="1" MaxHeight="220" Margin="0,16,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border Background="{DynamicResource AppHeaderBg}" CornerRadius="8" Padding="16"><TextBlock x:Name="OfferText" TextWrapping="Wrap" LineHeight="22"/></Border>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
  <TextBlock Text="保存位置" FontWeight="SemiBold"/>
  <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,8"><TextBlock x:Name="FolderText" Text="请先选择保存目录" Style="{StaticResource ProductHint}"/></ScrollViewer>
  <Button Content="选择保存目录…" Style="{StaticResource ProductSecondaryButton}" Click="Folder_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
  <TextBlock Text="接收后会在所选目录中新建本批文件夹，保留原目录结构。" Style="{StaticResource ProductHint}"/>
  </StackPanel>
  <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="拒绝" IsCancel="True" Style="{StaticResource ProductSecondaryButton}" Margin="8,0,0,0"/>
   <Button x:Name="AcceptButton" Content="接收" Style="{StaticResource ProductButton}" Margin="8,0,0,0" IsEnabled="False" Click="Accept_Click"/>
  </WrapPanel>
 </Grid></Border>
 </DockPanel>
</Window>
